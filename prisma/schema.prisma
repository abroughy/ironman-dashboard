generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String?
  raceType     String   @default("70.3")   // "70.3" | "140.6" | "olympic" | "sprint" | "marathon" | "half-marathon"
  raceDate     DateTime?
  isAdmin      Boolean  @default(false)
  onboarded    Boolean  @default(false)
  createdAt    DateTime @default(now())

  sessions          Session[]
  stravaToken       StravaToken?
  coachingSummaries CoachingSummary[]
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  discipline       String
  date             DateTime
  durationSecs     Int
  distanceMetres   Float
  avgHeartRate     Int?
  perceivedEffort  Int?
  notes            String?
  source           String
  stravaActivityId String?
  rawData          String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stravaActivityId])
  @@index([userId])
}

model StravaToken {
  id              String   @id @default(cuid())
  userId          String   @unique
  stravaAthleteId String?  @unique
  accessToken     String
  refreshToken    String
  expiresAt       DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoachingSummary {
  id          String   @id @default(cuid())
  userId      String
  weekStart   DateTime
  content     String
  generatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
}
